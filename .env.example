# --- Database ---
#MONGO_URI=mongodb://mongo:27017/insurance

# --- Email alerts (SendGrid) ---
#SENDGRID_API_KEY=SG.xxxx.xxxxx
#ALERT_SENDER_EMAIL=no-reply@yourdomain.com
#ALERT_RECEIVER_EMAIL=example@yourdomain.com

# --- Google OAuth / OIDC ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must match: https://<your-domain>/auth/callback
#GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# Random secret for signing session cookies (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
#SESSION_SECRET=replace-me-with-a-long-random-string

# Public URL of the app — used to build the OAuth redirect URI when running behind Cloudflare Tunnel.
# Example: https://insurance.example.com
#APP_BASE_URL=https://insurance.example.com

# Access control — set ONE or BOTH:
#   ALLOWED_EMAILS: comma-separated whitelist of full emails (highest precedence)
#   ALLOWED_DOMAIN: comma-separated whitelist of email domains (e.g. example.com)
#ALLOWED_EMAILS=you@example.com,partner@example.com
#ALLOWED_DOMAIN=example.com

# Optional shared secret to allow webhook/cron callers to bypass the login redirect.
# Send as header `X-Internal-Token: <value>` or query `?internal_token=<value>`.
#INTERNAL_API_TOKEN=replace-me-with-a-long-random-string

# Set to "1" to disable auth entirely (local dev only — never in production).
#AUTH_DISABLED=0
